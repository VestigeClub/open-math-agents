import certificates.«fifteen-cell-pentomino-pair-search»

/-! Exhaustive certificate for a pair of five-cell tiles. Each selected cell is
verified against the board, and every compatible placement is checked. -/
namespace FactorMaskCheck

private def packet4x13 (block : ℕ) : ℕ := (if block < 1 then  else 0x3de000003e00000043d000003de000003fd0000041d0000041f0000041f0000041f000003de000003e00000043d000003fd000003c0000003c0000003df00000402000003e0000003e0000003e0000003e100000c2200000c22)

def guide4x13 (id : ℕ) : ℕ :=
  (packet4x13 (id/64) >>> (32*(id%64))) % (2^32)

set_option maxRecDepth 24000 in
set_option maxHeartbeats 1600000 in
theorem guided_4_13 :
    guidedPair tile4 tile13 atMostThree guide4x13 5 ⟨,0,1,0⟩ 0=true := by
  decide +kernel

end FactorMaskCheck
