/-! Exhaustive certificate for a pair of five-cell tiles. Each selected cell is
verified against the board, and every compatible placement is checked. -/
namespace FactorMaskCheck

private def packet2x7 (block : ℕ) : ℕ := (if block < 5 then (if block < 2 then (if block < 1 then  else ) else (if block < 3 then  else (if block < 4 then  else ))) else (if block < 7 then (if block < 6 then  else ) else (if block < 8 then  else (if block < 9 then  else 0xb5b00000b7b00000bfb00000b9b00000bbb00000c3b00000b6300000b8300000c0300000ba300000bc300000c4000000b5d00000b7d00000bfd00000b9d00000bbd00000c3d00000b6500000b8500000c0500000ba500000bc500000c4000000b5b00000b5d00000c5d))))

def guide2x7 (id : ℕ) : ℕ :=
  (packet2x7 (id/64) >>> (32*(id%64))) % (2^32)

set_option maxRecDepth 24000 in
set_option maxHeartbeats 1600000 in
theorem guided_2_7 :
    guidedPair tile2 tile7 atMostThree guide2x7 5 ⟨,0,1,0⟩ 0=true := by
  decide +kernel

end FactorMaskCheck
