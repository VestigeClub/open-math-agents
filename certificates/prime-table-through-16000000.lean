def tally (f : ℕ → Bool) (s len : ℕ) : ℕ := (List.range' s len).countP f

theorem tally_succ (f : ℕ → Bool) (s len : ℕ) :
    tally f s (len+1) = tally f s len + (if f (s+len) then 1 else 0) := by
  unfold tally
  rw [← List.range'_append_1, List.countP_append]
  simp

def fromBlocks (c : ℕ → ℕ) (f : ℕ → Bool) (j : ℕ) : ℕ :=
  c (j/128) + tally f (128*(j/128)) (j%128)

theorem fromBlocks_succ (c : ℕ → ℕ) (f : ℕ → Bool) (j : ℕ)
    (boundary : c (j/128+1) = c (j/128) + tally f (128*(j/128)) 128) :
    fromBlocks c f (j+1) = fromBlocks c f j + (if f j then 1 else 0) := by
  have split := Nat.div_add_mod j 128
  have hs := tally_succ f (128*(j/128)) (j%128)
  rw [split] at hs
  unfold fromBlocks
  by_cases h : j%128=127
  · have div : (j+1)/128 = j/128+1 := by omega
    have rem : (j+1)%128 = 0 := by omega
    rw [div,rem,boundary]
    rw [show j%128+1=128 by omega] at hs
    simp [tally] at *
    omega
  · have div : (j+1)/128 = j/128 := by omega
    have rem : (j+1)%128 = j%128+1 := by omega
    rw [div,rem,hs]
    omega


