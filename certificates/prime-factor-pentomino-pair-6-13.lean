import certificates.«fifteen-cell-pentomino-pair-search»

/-! Exhaustive certificate for a pair of five-cell tiles. Each selected cell is
verified against the board, and every compatible placement is checked. -/
namespace FactorMaskCheck

private def packet6x13 (_block : ℕ) : ℕ := 0x3c0000003c0000003c0000003df000003c1000003df000003e0000003e000000be100000c22000003e000000be200000c22000003c1000003c1000003e200020c200001ec400001dc400001bc0100019c410001742100016c4100000c400001442100012c4100011c410000fc010000dc200000ac4000008c2000006c0100001c00

def guide6x13 (id : ℕ) : ℕ :=
  (packet6x13 (id/64) >>> (32*(id%64))) % (2^32)

set_option maxRecDepth 24000 in
set_option maxHeartbeats 1600000 in
theorem guided_6_13 :
    guidedPair tile6 tile13 atMostThree guide6x13 5 ⟨,0,1,0⟩ 0=true := by
  decide +kernel

end FactorMaskCheck
