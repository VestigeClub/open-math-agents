import certificates.«fifteen-cell-pentomino-pair-search»

/-! Exhaustive certificate for a pair of five-cell tiles. Each selected cell is
verified against the board, and every compatible placement is checked. -/
namespace FactorMaskCheck

private def packet5x13 (block : ℕ) : ℕ := (if block < 1 then  else 0x3e0000003e0000003e0000003e0000003c1000003c1000003c1000003c1000003e2000003de000003e2000003e2000003c0000003c0000003df000003e0000003e000000c22000003e0000003e000055c6200054c62)

def guide5x13 (id : ℕ) : ℕ :=
  (packet5x13 (id/64) >>> (32*(id%64))) % (2^32)

set_option maxRecDepth 24000 in
set_option maxHeartbeats 1600000 in
theorem guided_5_13 :
    guidedPair tile5 tile13 atMostThree guide5x13 5 ⟨,0,1,0⟩ 0=true := by
  decide +kernel

end FactorMaskCheck
