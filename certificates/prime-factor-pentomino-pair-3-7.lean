namespace FactorMaskCheck

private def packet3x7 (block : ℕ) : ℕ := (if block < 14 then (if block < 7 then (if block < 3 then (if block < 1 then  else (if block < 2 then  else )) else (if block < 5 then (if block < 4 then  else ) else (if block < 6 then  else ))) else (if block < 10 then (if block < 8 then  else (if block < 9 then  else )) else (if block < 12 then (if block < 11 then  else ) else (if block < 13 then  else )))) else (if block < 21 then (if block < 17 then (if block < 15 then  else (if block < 16 then  else )) else (if block < 19 then (if block < 18 then  else ) else (if block < 20 then  else ))) else (if block < 24 then (if block < 22 then  else (if block < 23 then  else )) else (if block < 26 then (if block < 25 then  else ) else (if block < 27 then  else 0x3bc000003bf0000037c)))))

def guide3x7 (id : ℕ) : ℕ :=
  (packet3x7 (id/64) >>> (32*(id%64))) % (2^32)

set_option maxRecDepth 24000 in
