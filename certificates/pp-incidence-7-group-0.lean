theorem checked7x0 (g : Orientation) : RowFact 7 0 g := by
  obtain ⟨a,b,c⟩:=g
  cases a <;> cases b <;> cases c
  · exact part7x0x0
  · exact part7x0x1
  · exact part7x0x2
  · exact part7x0x3
  · exact part7x0x4
  · exact part7x0x5
  · exact part7x0x6
  · exact part7x0x7

end HalfIndexRows
