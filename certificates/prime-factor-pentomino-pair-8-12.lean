import certificates.«fifteen-cell-pentomino-pair-search»

/-! Exhaustive certificate for a pair of five-cell tiles. Each selected cell is
verified against the board, and every compatible placement is checked. -/
namespace FactorMaskCheck

private def packet8x12 (block : ℕ) : ℕ := (if block < 6 then (if block < 3 then (if block < 1 then  else (if block < 2 then  else )) else (if block < 4 then  else (if block < 5 then  else ))) else (if block < 9 then (if block < 7 then  else (if block < 8 then  else )) else (if block < 10 then  else (if block < 11 then  else ))))

def guide8x12 (id : ℕ) : ℕ :=
  (packet8x12 (id/64) >>> (32*(id%64))) % (2^32)

set_option maxRecDepth 24000 in
set_option maxHeartbeats 1600000 in
theorem guided_8_12 :
    guidedPair tile8 tile12 atMostThree guide8x12 5 ⟨,0,1,0⟩ 0=true := by
  decide +kernel

end FactorMaskCheck
