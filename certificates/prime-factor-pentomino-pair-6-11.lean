/-! Exhaustive certificate for a pair of five-cell tiles. Each selected cell is
verified against the board, and every compatible placement is checked. -/
namespace FactorMaskCheck

private def packet6x11 (block : ℕ) : ℕ := (if block < 6 then (if block < 3 then (if block < 1 then  else (if block < 2 then  else )) else (if block < 4 then  else (if block < 5 then  else ))) else (if block < 9 then (if block < 7 then  else (if block < 8 then  else )) else (if block < 10 then  else (if block < 11 then  else 0xb9f00000b9f00000b9f00000bc100000bc100000bc10000035e000003610000037e0000037f000003c00000039f000003a0000003a2000003c0000003e200000ba100000bc000000ba100000bc000000360000003630000038200000382000003c00000039e000003a1000003a1000003c1000003df000003e0000003e0))))

def guide6x11 (id : ℕ) : ℕ :=
  (packet6x11 (id/64) >>> (32*(id%64))) % (2^32)

set_option maxRecDepth 24000 in
set_option maxHeartbeats 1600000 in
theorem guided_6_11 :
    guidedPair tile6 tile11 atMostThree guide6x11 5 ⟨,0,1,0⟩ 0=true := by
  decide +kernel

end FactorMaskCheck
