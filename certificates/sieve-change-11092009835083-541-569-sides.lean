private theorem side_step {a p q previous side result : ℕ} {ps : List ℕ}
    (above_lookup : 65536<q) (above_table : 745089<q) (off_wheel : p≠13)
    (ordered : p≤q) (old : R a ps q=previous) (removed : R a ps (q/p)=side)
    (sum : previous-side=result) : R (a+1) (p::ps) q=result := by
  have lookup : ¬ (q≤65536 ∧ 19≤p ∧ p≤127) := by omega
  have small : ¬ q<p := by omega
  have short : ¬ (q<(p+1)^2 ∧ q≤745089) := by omega
  change rankedPhi tab (a+1) (p::ps) q=result
  rw [rankedPhi, if_neg lookup, if_neg off_wheel, if_neg small, if_neg short]
  change R a ps q - R a ps (q/p)=result
  rw [old,removed]
  exact sum

