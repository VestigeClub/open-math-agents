private abbrev Phase := List ℕ × ℕ

private def finalRank : ℕ → List Phase → ℕ
  | a, [] => a
  | a, (block,_)::rest => finalRank (a+block.length) rest

private def finalList : List ℕ → List Phase → List ℕ
  | base, [] => base
  | base, (block,_)::rest => finalList (block++base) rest

private def finalValue : ℕ → List Phase → ℕ
  | v, [] => v
  | _, (_,goal)::rest => finalValue goal rest

private def traceCheck (q : ℕ) : ℕ → List ℕ → ℕ → List Phase → Bool
  | _, _, _, [] => true
  | a, base, v, (block,goal)::rest =>
      (resumeRank base v (a+block.length) block q == goal) &&
        traceCheck q (a+block.length) (block++base) goal rest

private theorem trace_sound (q : ℕ) (steps : List Phase) :
    ∀ a base v, R a base q=v → traceCheck q a base v steps=true →
      R (finalRank a steps) (finalList base steps) q=finalValue v steps := by
  induction steps with
  | nil =>
    intro a base v old _
    exact old
  | cons pair rest ih =>
    obtain ⟨block,goal⟩ := pair
    intro a base v old certified
    change ( (_ == goal) && traceCheck q (a+block.length) (block++base) goal rest)=true at certified
    have both := Bool.and_eq_true_iff.mp certified
    have nextValue : resumeRank base v (a+block.length) block q=goal := beq_iff_eq.mp both.1
    exact ih (a+block.length) (block++base) goal
      ((resume_correct block base a q v old).trans nextValue) both.2

private theorem recover_row {q target r : ℕ} {ps : List ℕ} (steps : List Phase)
    (ri : finalRank 0 steps=r) (li : finalList [] steps=ps) (vi : finalValue q steps=target)
    (proof : traceCheck q 0 [] q steps=true) : R r ps q=target := by
  have correct := trace_sound q steps 0 [] q rfl proof
  simpa only [ri,li,vi] using correct

