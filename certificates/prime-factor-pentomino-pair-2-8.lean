import certificates.«fifteen-cell-pentomino-pair-search»

/-! Exhaustive certificate for a pair of five-cell tiles. Each selected cell is
verified against the board, and every compatible placement is checked. -/
namespace FactorMaskCheck

private def packet2x8 (block : ℕ) : ℕ := (if block < 4 then (if block < 2 then (if block < 1 then  else ) else (if block < 3 then  else )) else (if block < 6 then (if block < 5 then  else ) else (if block < 7 then  else (if block < 8 then  else ))))

def guide2x8 (id : ℕ) : ℕ :=
  (packet2x8 (id/64) >>> (32*(id%64))) % (2^32)

set_option maxRecDepth 24000 in
set_option maxHeartbeats 1600000 in
theorem guided_2_8 :
    guidedPair tile2 tile8 atMostThree guide2x8 5 ⟨,0,1,0⟩ 0=true := by
  decide +kernel

end FactorMaskCheck
