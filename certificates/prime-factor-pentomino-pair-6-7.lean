/-! Exhaustive certificate for a pair of five-cell tiles. Each selected cell is
verified against the board, and every compatible placement is checked. -/
namespace FactorMaskCheck

private def packet6x7 (block : ℕ) : ℕ := (if block < 7 then (if block < 3 then (if block < 1 then  else (if block < 2 then  else )) else (if block < 5 then (if block < 4 then  else ) else (if block < 6 then  else ))) else (if block < 11 then (if block < 9 then (if block < 8 then  else ) else (if block < 10 then  else )) else (if block < 13 then (if block < 12 then  else ) else (if block < 14 then  else 0x3c2))))

def guide6x7 (id : ℕ) : ℕ :=
  (packet6x7 (id/64) >>> (32*(id%64))) % (2^32)

set_option maxRecDepth 24000 in
set_option maxHeartbeats 1600000 in
theorem guided_6_7 :
    guidedPair tile6 tile7 atMostThree guide6x7 5 ⟨,0,1,0⟩ 0=true := by
  decide +kernel

end FactorMaskCheck
