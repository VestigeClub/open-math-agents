private def witness (area id : ℕ) : Option Entry :=
  if area=2 then witness2 id else if area=4 then witness4 id else
  if area=7 then witness7 id else if area=8 then witness8 id else none

private def good (area id : ℕ) (e : Entry) : Bool :=
  building e.cells && decide (1<e.cells.toFinset.card ∧ e.cells.toFinset.card<area) &&
    checkTiling e.cells.toFinset (HalfCatalogue.shape area id) e.places

private def composite (area id : ℕ) : Bool :=
  match witness area id with
  | none => false
  | some e => good area id e

set_option maxRecDepth 20000 in
set_option maxHeartbeats 3200000 in
private theorem certificate_complete :
    ([2,4,7,8].all fun area => (List.range (HalfCatalogue.count area)).all
      (fun id => allowed area id || composite area id))=true := by decide +kernel

theorem allowed_of_prime {area id : ℕ} (supported : area∈([2,4,7,8] : List ℕ))
    (bound : id<HalfCatalogue.count area) {f : Shape} (size : f.card=area) (prime : primeShape f)
    (rel : congruent f (HalfCatalogue.shape area id)) : allowed area id=true := by
  have each := List.all_eq_true.mp (List.all_eq_true.mp certificate_complete area supported) id
    (List.mem_range.mpr bound)
  simp only [Bool.or_eq_true] at each
  rcases each with yes|no
  · exact yes
  · unfold composite at no
    cases h : witness area id with
    | none => simp [h] at no
    | some e =>
      have hgood : good area id e=true := by simpa [h] using no
      simp only [good,Bool.and_eq_true,decide_eq_true_eq] at hgood
      have poly := poly_of_building e.cells hgood.1.1
      have tiled := transport_tiles (checked_tiling hgood.2) (motion_symm rel)
      have same := prime.2.2 e.cells.toFinset poly hgood.1.2.1 tiled
      omega

end HalfPrimes

