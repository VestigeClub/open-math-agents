/-! Exhaustive certificate for a pair of five-cell tiles. Each selected cell is
verified against the board, and every compatible placement is checked. -/
namespace FactorMaskCheck

private def packet7x12 (block : ℕ) : ℕ := (if block < 8 then (if block < 4 then (if block < 2 then (if block < 1 then  else ) else (if block < 3 then  else )) else (if block < 6 then (if block < 5 then  else ) else (if block < 7 then  else ))) else (if block < 12 then (if block < 10 then (if block < 9 then  else ) else (if block < 11 then  else )) else (if block < 14 then (if block < 13 then  else ) else (if block < 15 then  else 0xbdf))))

def guide7x12 (id : ℕ) : ℕ :=
  (packet7x12 (id/64) >>> (32*(id%64))) % (2^32)

set_option maxRecDepth 24000 in
set_option maxHeartbeats 1600000 in
theorem guided_7_12 :
    guidedPair tile7 tile12 atMostThree guide7x12 5 ⟨,0,1,0⟩ 0=true := by
  decide +kernel

end FactorMaskCheck
