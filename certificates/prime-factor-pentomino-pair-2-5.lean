import certificates.«fifteen-cell-pentomino-pair-search»

/-! Exhaustive certificate for a pair of five-cell tiles. Each selected cell is
verified against the board, and every compatible placement is checked. -/
namespace FactorMaskCheck

private def packet2x5 (block : ℕ) : ℕ := (if block < 12 then (if block < 6 then (if block < 3 then (if block < 1 then  else (if block < 2 then  else )) else (if block < 4 then  else (if block < 5 then  else ))) else (if block < 9 then (if block < 7 then  else (if block < 8 then  else )) else (if block < 10 then  else (if block < 11 then  else )))) else (if block < 18 then (if block < 15 then (if block < 13 then  else (if block < 14 then  else )) else (if block < 16 then  else (if block < 17 then  else ))) else (if block < 21 then (if block < 19 then  else (if block < 20 then  else )) else (if block < 22 then  else (if block < 23 then  else 0xc1e)))))

def guide2x5 (id : ℕ) : ℕ :=
  (packet2x5 (id/64) >>> (32*(id%64))) % (2^32)

set_option maxRecDepth 24000 in
set_option maxHeartbeats 1600000 in
theorem guided_2_5 :
    guidedPair tile2 tile5 atMostThree guide2x5 5 ⟨,0,1,0⟩ 0=true := by
  decide +kernel

end FactorMaskCheck
