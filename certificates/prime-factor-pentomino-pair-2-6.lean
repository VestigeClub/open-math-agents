import certificates.«fifteen-cell-pentomino-pair-search»

/-! Exhaustive certificate for a pair of five-cell tiles. Each selected cell is
verified against the board, and every compatible placement is checked. -/
namespace FactorMaskCheck

private def packet2x6 (block : ℕ) : ℕ := (if block < 3 then (if block < 1 then  else (if block < 2 then  else )) else (if block < 4 then  else (if block < 5 then  else )))

def guide2x6 (id : ℕ) : ℕ :=
  (packet2x6 (id/64) >>> (32*(id%64))) % (2^32)

set_option maxRecDepth 24000 in
set_option maxHeartbeats 1600000 in
theorem guided_2_6 :
    guidedPair tile2 tile6 atMostThree guide2x6 5 ⟨,0,1,0⟩ 0=true := by
  decide +kernel

end FactorMaskCheck
